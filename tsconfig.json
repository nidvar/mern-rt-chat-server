{
  "compilerOptions": {
    "module": "commonjs",           // ✅ CommonJS output
    "target": "ES2020",
    "esModuleInterop": true,        // ✅ allows `import express from 'express'`
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
