{
  "compilerOptions": {
    "module": "ES2020",               // ES module output
    "target": "ES2020",
    "moduleResolution": "node",       // Fixes resolveJsonModule error
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,        // Can now be used safely
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
